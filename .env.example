# ── classroom-backend environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Vars marked (required) throw at startup if missing.

# ── Database ──────────────────────────────────────────────────────────────────
# (required) Postgres connection string. Use the *pooled* endpoint on Neon.
DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'
# (optional) Pool tuning. Keep DATABASE_URL on Neon’s `-pooler` endpoint.
DB_POOL_MAX=3
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000
DB_MAX_LIFETIME_SECONDS=120
DB_MAX_USES=500

# ── URLs / CORS ───────────────────────────────────────────────────────────────
# (required) Origin of the frontend — used for CORS and as a Better Auth trusted origin.
FRONTEND_URL='http://localhost:5173'
# (optional) Port this server listens on. Default: 8000
PORT=8000
# (optional) In production, auth cookies use Secure + SameSite=None for a
# separate frontend origin. Keep development for local HTTP cookies.
NODE_ENV=development
SCHOOL_NAME='Eckernforde Schools'

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# (required) Public base URL of THIS backend (where /api/auth/* is served).
BETTER_AUTH_URL='http://localhost:8000'
# (required) Random 32+ char secret. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET='replace-with-a-long-random-string'

# (optional) Google OAuth — the social provider is only registered when BOTH are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Arcjet (rate limiting / bot detection) ────────────────────────────────────
# (required unless NODE_ENV=test) Arcjet site key.
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxx
# (optional) LIVE | DRY_RUN — overrides the NODE_ENV-based default.
ARCJET_MODE=DRY_RUN

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# (optional) Brevo transactional email. When configured, Brevo is preferred over Resend.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Eckernforde Schools
# (optional) recipient for public admissions enquiry notifications.
ADMISSIONS_NOTIFICATION_EMAIL=admissions@yourdomain.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Server holds only the SECRET — it signs upload requests via POST /api/uploads/sign.
# The cloud name / API key live in the frontend .env (safe to expose to the browser).
CLOUDINARY_API_SECRET=

# ── AI assistant (Anthropic) ─────────────────────────────────────────────────
# (optional) Without it, POST /api/ai-assistant/chat returns a "not configured" error.
ANTHROPIC_API_KEY=

# ── APM Insight ───────────────────────────────────────────────────────────────
# The agent reads apminsightnode.json (also gitignored — see apminsightnode.json.example),
# OR these env vars if that file is absent:
# APMINSIGHT_LICENSE_KEY=
# APMINSIGHT_APP_NAME=classroom-backend
# APMINSIGHT_APP_PORT=10000
# APMINSIGHT_AGENT_DISABLE=true   # disable the agent entirely (e.g. local dev)
